# CreativeFlow Environment Configuration Example
DEBUG=True
SECRET_KEY=creativeflow-dev-secret-key-change-in-production-123456789
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database (Default: SQLite for local dev, PostgreSQL for production)
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3
# For PostgreSQL:
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=creativeflow_db
# DB_USER=creative_user
# DB_PASSWORD=creative_pass
# DB_HOST=localhost
# DB_PORT=5432

